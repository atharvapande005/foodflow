# Copy to .env.local. Only PUBLIC values belong here.
# The Razorpay secret key and the Supabase service-role key must NEVER appear in
# this folder - they live in server/.env and are only read by the API.

# Where the FoodFlow API lives.
VITE_API_BASE_URL=http://localhost:5000/api

# Supabase project URL and anon (publishable) key. The anon key is safe to
# expose: RLS blocks all direct table access, and it is only used to refresh an
# expired student session. Find both under Project Settings -> API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key