# Copy this file to .env and fill in real values. Never commit .env to Git.

# --- Supabase (Project Settings -> API in the Supabase dashboard) ---
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# service_role key BYPASSES Row Level Security. Rotate it before using this app.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# anon key is safe to expose, it is only used for verifying user JWTs.
SUPABASE_ANON_KEY=your-anon-key

# --- Razorpay (Dashboard -> Settings -> API Keys) ---
# Leave these blank to run in SIMULATED payment mode (no money moves, full flow works).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set to true to accept only live-mode Razorpay keys (blocks test keys in production).
RAZORPAY_LIVE_ONLY=false
RAZORPAY_WEBHOOK_SECRET=

# --- Admin ---
# Shared secret for the canteen admin portal. Sent as the x-admin-key header.
ADMIN_API_KEY=change-me-to-a-long-random-string

# --- Server ---
PORT=5000
NODE_ENV=development
# Comma separated list of origins allowed to call this API. Use * to allow any.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# --- Order pricing (all in rupees) ---
# Flat packing fee added to every order.
PACKING_FEE=15
# Orders at or above this subtotal get free packing. 0 disables it.
FREE_PACKING_ABOVE=300
# How many menu recommendations to compute per request.
RECOMMENDATION_LIMIT=8